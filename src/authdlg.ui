<!DOCTYPE UI><UI version="3.1" stdsetdef="1">
<class>AuthDlg</class>
<widget class="QWidget">
    <property name="name">
        <cstring>AuthDlg</cstring>
    </property>
    <property name="geometry">
        <rect>
            <x>0</x>
            <y>0</y>
            <width>400</width>
            <height>299</height>
        </rect>
    </property>
    <property name="caption">
        <string>Authenticate</string>
    </property>
    <widget class="QFrame">
        <property name="name">
            <cstring>frame5</cstring>
        </property>
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>400</width>
                <height>300</height>
            </rect>
        </property>
        <property name="paletteBackgroundPixmap">
            <pixmap></pixmap>
        </property>
        <property name="backgroundOrigin">
            <enum>AncestorOrigin</enum>
        </property>
        <property name="frameShape">
            <enum>StyledPanel</enum>
        </property>
        <property name="frameShadow">
            <enum>Raised</enum>
        </property>
        <property name="lineWidth">
            <number>0</number>
        </property>
        <widget class="QLabel">
            <property name="name">
                <cstring>textLabel4</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>190</x>
                    <y>120</y>
                    <width>190</width>
                    <height>30</height>
                </rect>
            </property>
            <property name="paletteForegroundColor">
                <color>
                    <red>255</red>
                    <green>255</green>
                    <blue>255</blue>
                </color>
            </property>
            <property name="backgroundOrigin">
                <enum>AncestorOrigin</enum>
            </property>
            <property name="font">
                <font>
                    <bold>1</bold>
                </font>
            </property>
            <property name="text">
                <string>&lt;h3&gt;&lt;b&gt;New contact received!&lt;/b&gt;&lt;/h3&gt;</string>
            </property>
        </widget>
        <widget class="QPushButton">
            <property name="name">
                <cstring>btnOK</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>140</x>
                    <y>260</y>
                    <width>111</width>
                    <height>30</height>
                </rect>
            </property>
            <property name="autoMask">
                <bool>true</bool>
            </property>
            <property name="text">
                <string>&amp;Ok</string>
            </property>
            <property name="default">
                <bool>true</bool>
            </property>
        </widget>
        <widget class="QCheckBox">
            <property name="name">
                <cstring>m_block</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>70</x>
                    <y>220</y>
                    <width>270</width>
                    <height>22</height>
                </rect>
            </property>
            <property name="paletteForegroundColor">
                <color>
                    <red>255</red>
                    <green>255</green>
                    <blue>255</blue>
                </color>
            </property>
            <property name="backgroundOrigin">
                <enum>AncestorOrigin</enum>
            </property>
            <property name="autoMask">
                <bool>true</bool>
            </property>
            <property name="text">
                <string>Block Contact</string>
            </property>
        </widget>
        <widget class="QCheckBox">
            <property name="name">
                <cstring>m_allow</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>70</x>
                    <y>190</y>
                    <width>290</width>
                    <height>22</height>
                </rect>
            </property>
            <property name="paletteForegroundColor">
                <color>
                    <red>255</red>
                    <green>255</green>
                    <blue>255</blue>
                </color>
            </property>
            <property name="backgroundOrigin">
                <enum>AncestorOrigin</enum>
            </property>
            <property name="autoMask">
                <bool>true</bool>
            </property>
            <property name="text">
                <string>Allow this contact to  see your online state</string>
            </property>
            <property name="checked">
                <bool>true</bool>
            </property>
        </widget>
        <widget class="QLabel">
            <property name="name">
                <cstring>m_handle</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>160</x>
                    <y>150</y>
                    <width>230</width>
                    <height>20</height>
                </rect>
            </property>
            <property name="paletteForegroundColor">
                <color>
                    <red>170</red>
                    <green>0</green>
                    <blue>0</blue>
                </color>
            </property>
            <property name="backgroundOrigin">
                <enum>AncestorOrigin</enum>
            </property>
            <property name="font">
                <font>
                    <bold>1</bold>
                </font>
            </property>
            <property name="text">
                <string></string>
            </property>
            <property name="alignment">
                <set>AlignCenter</set>
            </property>
        </widget>
    </widget>
</widget>
<connections>
    <connection>
        <sender>m_allow</sender>
        <signal>clicked()</signal>
        <receiver>m_block</receiver>
        <slot>toggle()</slot>
    </connection>
    <connection>
        <sender>m_block</sender>
        <signal>clicked()</signal>
        <receiver>m_allow</receiver>
        <slot>toggle()</slot>
    </connection>
</connections>
<tabstops>
    <tabstop>m_allow</tabstop>
    <tabstop>m_block</tabstop>
    <tabstop>btnOK</tabstop>
</tabstops>
<includes>
    <include location="local" impldecl="in implementation">authdlg.ui.h</include>
</includes>
<functions>
    <function returnType="QPixmap">getBgPixmap()</function>
</functions>
<pixmapfunction>getBgPixmap</pixmapfunction>
<layoutdefaults spacing="0" margin="0"/>
</UI>
