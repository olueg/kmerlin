    </connection>
    <connection>
        <sender>btnApp</sender>
        <signal>clicked()</signal>
        <receiver>SystemNotification</receiver>
        <slot>openApp()</slot>
    </connection>
    <connection>
        <sender>m_soundFile</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>SystemNotification</receiver>
        <slot>soundChanged(const QString&amp;)</slot>
    </connection>
</connections>
