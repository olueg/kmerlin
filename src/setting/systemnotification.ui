    <connection>
        <sender>m_List</sender>
        <signal>selectionChanged(QListViewItem*)</signal>
        <receiver>SystemNotification</receiver>
        <slot>selectionChanged(QListViewItem*)</slot>
    </connection>
    <connection>
        <sender>btnPlay</sender>
        <signal>clicked()</signal>
        <receiver>SystemNotification</receiver>
        <slot>playSound()</slot>
    </connection>
    <connection>
        <sender>btnSound</sender>
        <signal>clicked()</signal>
        <receiver>SystemNotification</receiver>
        <slot>openSound()</slot>
