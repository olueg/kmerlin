<connections>
    <connection>
        <sender>btnConnect</sender>
        <signal>clicked()</signal>
        <receiver>Login</receiver>
        <slot>slotConnect()</slot>
    </connection>
    <connection>
        <sender>m_login</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>Login</receiver>
        <slot>slotDataChanged(const QString&amp;)</slot>
    </connection>
    <connection>
        <sender>m_nick</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>Login</receiver>
        <slot>slotDataChanged(const QString&amp;)</slot>
    </connection>
    <connection>
        <sender>m_password</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>Login</receiver>
        <slot>slotDataChanged(const QString&amp;)</slot>
    </connection>
    <connection>
        <sender>m_profile</sender>
        <signal>activated(int)</signal>
        <receiver>Login</receiver>
        <slot>slotActivated(int)</slot>
    </connection>
</connections>
<tabstops>
    <tabstop>m_profile</tabstop>
    <tabstop>m_login</tabstop>
    <tabstop>m_nick</tabstop>
    <tabstop>m_password</tabstop>
    <tabstop>btnConnect</tabstop>
    <tabstop>m_save</tabstop>
</tabstops>
<includes>
    <include location="local" impldecl="in implementation">login.ui.h</include>
</includes>
<slots>
    <slot>slotConnect()</slot>
    <slot>slotDataChanged( const QString &amp; )</slot>
    <slot>slotActivated( int )</slot>
    <slot specifier="non virtual">updateCombo()</slot>
    <slot specifier="non virtual">slotUpdateAll( bool f )</slot>
</slots>
<functions>
    <function returnType="QPixmap">getBgPixmap()</function>
    <function>init()</function>
</functions>
<pixmapfunction>getBgPixmap</pixmapfunction>
<layoutdefaults spacing="0" margin="0"/>
<includehints>
